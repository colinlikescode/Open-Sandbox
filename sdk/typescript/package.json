    "test:e2e": "node test/e2b.integration.mjs",
    "lint": "tsc -p tsconfig.lint.json"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "e2b": "2.51.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@balena/dockerignore": "^1.0.2",
    "tar": "^7.5.22"
  }
}
